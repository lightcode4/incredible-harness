{
  "manifest_version": 3,
  "name": "LightCode⁴ for Chrome",
  "version": "1.0.0",
  "description": "Lets your LightCode⁴ agent read and use pages in your own Chrome, with your approval for every click and keystroke.",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "LightCode⁴" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
